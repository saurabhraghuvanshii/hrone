# Copy to .env and adjust. Real environment variables take priority over .env.

# Local MongoDB container (used by docker-compose.yml, optional)
MONGO_IMAGE=mongo:7
MONGO_CONTAINER=hrone-mongo
MONGO_PORT=27017
MONGO_ROOT_USER=hrone
MONGO_ROOT_PASSWORD=change_me

# App settings
MONGO_URI=mongodb://hrone:change_me@localhost:27017/?authSource=admin
MONGO_DB=attendance_db
